# رقم المنفذ الذي يستمع عليه الخادم (مطابق لمنفذ 8080 في منصة Northflank)
PORT=8080

# مفتاح مصادقة منصة OpenAI الجديد (يُترك فارغاً هنا أو يوضع مثال توضيحي)
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXX

# نموذج الذكاء الاصطناعي المستخدم
OPENAI_MODEL=gpt-4.1-mini

# نطاق السماح للطلبات الخارجية (CORS)
ALLOWED_ORIGIN=*
